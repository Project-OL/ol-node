# Intentionally empty / non-secret.
# Docker Compose auto-loads `.env` for interpolation; that file may contain
# multiline PEMs Compose cannot parse. Point COMPOSE_ENV_FILES here instead:
#   Windows PowerShell:
#     $env:COMPOSE_ENV_FILES="docker-compose.env"; docker compose up --build
#   bash:
#     COMPOSE_ENV_FILES=docker-compose.env docker compose up --build
#
# Staging AWS (face worker / Rekognition): copy docker-compose.aws-staging.env.example
# to docker-compose.aws-staging.env — loaded automatically by compose (gitignored).
#
# Application secrets for the stack are defined inline in docker-compose.yml
# (local disposable values only).
