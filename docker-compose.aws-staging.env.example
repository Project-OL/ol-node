# Copy to docker-compose.aws-staging.env (gitignored) for local Docker face-worker + AWS smoke tests.
# Use staging-only IAM user keys — never production keys, never commit the copied file.
#
#   cp docker-compose.aws-staging.env.example docker-compose.aws-staging.env
#   # edit docker-compose.aws-staging.env with real staging values
#   COMPOSE_ENV_FILES=docker-compose.env docker compose up --build
#
# Production worker EC2: omit these keys; attach an IAM instance role instead (see docs/deployment-architecture.md).

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=ol-app-storage-staging
REKOGNITION_COLLECTION_ID=face-staging
