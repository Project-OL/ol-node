{
    "name": "vone-backend",
    "version": "1.0.0",
    "description": "Vone VoIP REST API",
    "main": "dist/server.js",
    "engines": {
        "node": ">=20.0.0"
    },
    "overrides": {
        "fast-jwt": "^6.2.4",
        "fast-uri": "^3.1.2",
        "uuid": "^11.1.1",
        "tar": "^7.5.16"
    },
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "dev:ws": "cd ../ws-server && npm run dev",
        "start:ws": "cd ../ws-server && npm run start",
        "dev:all": "concurrently \"npm run dev\" \"npm run dev:ws\"",
        "build": "tsc",
        "start": "node dist/server.js",
        "worker": "tsx src/worker.ts",
        "worker:prod": "node dist/worker.js",
        "worker:face-index": "tsx src/worker-face-index.ts",
        "worker:face-index:prod": "node dist/worker-face-index.js",
        "lint": "eslint \"src/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" --fix",
        "format": "prettier --write \"src/**/*.ts\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:rich-tier-sim": "vitest run tests/integration/rich-tier-time-compressed.test.ts",
        "test:coverage": "vitest run --coverage",
        "db:migrate": "prisma migrate dev",
        "db:migrate:prod": "prisma migrate deploy",
        "db:generate": "prisma generate",
        "db:studio": "prisma studio",
        "db:seed": "tsx prisma/seed.ts",
        "wallet:enqueue-level-backfill": "tsx scripts/enqueue-level-backfill.ts",
        "backfill:vip-public-ids": "tsx scripts/backfill-vip-public-ids.ts",
        "typecheck": "tsc --noEmit",
        "api-contract:lock": "tsx scripts/generate-api-contract-lock.ts && tsx scripts/generate-api-contract-index.ts",
        "api-surface:generate": "tsx scripts/generate-api-surface.ts",
        "api-surface:coverage": "tsx scripts/generate-coverage-matrix.ts",
        "test:http": "vitest run tests/http",
        "postman:auth": "node scripts/generate-auth-postman-collection.mjs",
        "grant:trading-coins": "tsx scripts/grant-trading-coins.ts",
        "seed:agency-agent-dev": "tsx scripts/seed-agency-agent-dev.ts",
        "seed:super-admin": "tsx src/scripts/seed-super-admin.ts",
        "seed:admin-views": "tsx scripts/seed-admin-views.ts",
        "seed:coin-trading-rates": "tsx scripts/seed-coin-trading-rates.ts",
        "seed:coin-trading-topup-packages": "tsx scripts/seed-coin-trading-topup-packages.ts",
        "lab:seed": "tsx lab/fixtures/seed.ts",
        "lab:concurrency": "vitest run lab/concurrency --fileParallelism=false",
        "lab:auth": "k6 run lab/modules/02-auth/k6-scenario.js",
        "lab:users": "k6 run lab/modules/03-users-social/k6-scenario.js",
        "lab:messaging": "k6 run lab/modules/04-messaging/k6-scenario.js",
        "lab:wallet": "k6 run lab/modules/05-wallet/k6-scenario.js",
        "lab:gifts": "k6 run lab/modules/06-gifts-calls/k6-scenario.js",
        "lab:soak": "k6 run lab/k6/scenarios/12_full_soak.js",
        "lab:all": "bash lab/scripts/run_all.sh",
        "lab:report": "tsx lab/scripts/analyze_report.ts",
        "lab:probe": "tsx lab/scripts/probe-endpoints.ts",
        "lab:perf-doc": "tsx lab/scripts/generate-endpoint-performance-doc.ts",
        "lab:perf": "npm run lab:probe && npm run lab:perf-doc"
    },
    "dependencies": {
        "@aws-sdk/client-rekognition": "^3.1046.0",
        "@aws-sdk/client-s3": "^3.600.0",
        "@aws-sdk/client-ses": "^3.1063.0",
        "@aws-sdk/s3-request-presigner": "^3.600.0",
        "@fastify/compress": "^7.0.0",
        "@fastify/cors": "^9.0.1",
        "@fastify/helmet": "^11.1.1",
        "@fastify/jwt": "^8.0.1",
        "@fastify/multipart": "^8.3.0",
        "@fastify/rate-limit": "^9.1.0",
        "@fastify/swagger": "^8.14.0",
        "@fastify/swagger-ui": "^4.0.1",
        "@fastify/websocket": "^10.0.1",
        "@prisma/client": "^5.16.0",
        "axios": "^1.17.0",
        "bcrypt": "^5.1.1",
        "bullmq": "^5.71.0",
        "dotenv": "^16.4.5",
        "fastify": "^4.29.1",
        "ffmpeg-static": "^5.3.0",
        "firebase-admin": "^12.3.0",
        "google-auth-library": "^9.15.1",
        "ioredis": "^5.4.1",
        "jpeg-js": "^0.4.4",
        "jsonwebtoken": "^9.0.3",
        "libphonenumber-js": "^1.11.6",
        "livekit-server-sdk": "^2.15.0",
        "pino": "^9.3.2",
        "pino-pretty": "^11.2.1",
        "redis": "^6.1.0",
        "sanitize-html": "^2.17.4",
        "uuid": "^11.1.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20.14.11",
        "@types/sanitize-html": "^2.16.1",
        "@types/uuid": "^10.0.0",
        "@types/ws": "^8.18.1",
        "@typescript-eslint/eslint-plugin": "^7.16.1",
        "@typescript-eslint/parser": "^7.16.1",
        "@vitest/coverage-v8": "^4.1.8",
        "concurrently": "^9.0.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.2.1",
        "prettier": "^3.3.3",
        "prisma": "^5.16.0",
        "tsx": "^4.16.2",
        "typescript": "^5.5.3",
        "vitest": "^4.1.8"
    }
}
