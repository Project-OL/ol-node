NODE_ENV=development
PORT=3000
API_VERSION=v1
LOG_LEVEL=debug

# Database (Neon, RDS, etc.)
# Add ?connection_limit=20 (or higher) for pool tuning under concurrency (see docs/SCALING.md)
DATABASE_URL="postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require&connection_limit=20"
# Optional: direct connection URL for migrations
DATABASE_DIRECT_URL="postgresql://<user>:<password>@<neon-direct-host>/<db>?sslmode=require"
# Optional: read replica URL for scaling reads (repos use prismaRead when set)
DATABASE_READ_URL=
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# Redis (Upstash, ElastiCache, etc.)
REDIS_URL="rediss://:<password>@<upstash-host>:6379"
# Optional: read replica URL for read-only Redis-style cache reads when set
REDIS_READ_URL=
# Most managed Redis providers embed the password in the URL; leave blank unless needed
REDIS_PASSWORD=
# /me and profile cache (seconds)
REDIS_TTL_ME=900
REDIS_TTL_PROFILE=3600
REDIS_COMMAND_TIMEOUT_MS=3000

# JWT (one secret used for access and refresh tokens)
JWT_ACCESS_SECRET="<access-secret-base64>"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_SECRET=<refresh-secret-base64>
# CORS
ALLOWED_ORIGINS=http://localhost:3000

# k6 load testing (auth suite in k6-auth-tests/)
# BASE_URL should point to this API server; INFLUX_URL/GRAFANA_URL
# are only needed when streaming metrics to InfluxDB + Grafana.
BASE_URL=http://localhost:3000
INFLUX_URL=http://localhost:8086
GRAFANA_URL=http://localhost:3000

# Firebase Admin (same project as app google-services.json, e.g. project_id olappnew).
# Create a service account in Firebase Console → Project settings → Service accounts → Generate new private key.
# Do not commit the JSON; set project id + client_email + private_key here.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Sign-In ID tokens (iss=https://accounts.google.com): audiences from google-services.json oauth_client.
# Web client (client_type 3), required for typical Flutter google_sign_in server verification:
GOOGLE_OAUTH_WEB_CLIENT_ID=
# Android OAuth client (client_type 1); add if your tokens use this client as aud:
GOOGLE_OAUTH_ANDROID_CLIENT_ID=
# iOS OAuth client (client_type 2); add for com.example.olApp (or your bundle id):
GOOGLE_OAUTH_IOS_CLIENT_ID=

# Optional: ML, SMS, etc.
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=

OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5
SMS_PROVIDER_API_KEY=
STATIC_OTP_DEV=22222

# AWS S3 (presigned URL avatar uploads)
AWS_ACCESS_KEY_ID=AKIAWYX3LJJO4R2DP5TL
AWS_SECRET_ACCESS_KEY=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
AWS_REGION=ap-south-1
AWS_S3_BUCKET=ol-app-storage
# Optional: CDN host (no https://) for avatars uploaded via PATCH /users/me
CLOUDFRONT_DOMAIN=
MAX_AVATAR_SIZE_BYTES=5242880

# Security password (separate from login password)
SECURITY_PASSWORD_ENABLED=true
SECURITY_PASSWORD_FAILED_ATTEMPTS_LIMIT=3
SECURITY_PASSWORD_LOCKOUT_DURATION_MINUTES=60
SECURITY_PASSWORD_RESET_TOKEN_EXPIRY_SECONDS=600

# WebSocket Server (separate process)
WS_PORT=3001

# Messaging
MSG_HOT_CACHE_SIZE=100
MSG_UPLOAD_TTL_SECONDS=300

# Gifts — points credited to receiver = floor(coinCost * rate)
GIFT_COIN_TO_POINT_RATE=1
# Comma-separated user UUIDs allowed to manage gifts / galleries (JWT must match)
ADMIN_USER_IDS=