NODE_ENV=development
PORT=3000
API_VERSION=v1
LOG_LEVEL=debug

# Database (Neon, RDS, etc.)
# Add ?connection_limit=20 (or higher) for pool tuning under concurrency (see docs/SCALING.md)
DATABASE_URL="postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require&connection_limit=20"
# Optional: direct connection URL for migrations
DATABASE_DIRECT_URL="postgresql://<user>:<password>@<neon-direct-host>/<db>?sslmode=require"
# Optional: read replica URL for scaling reads (repos use prismaRead when set)
DATABASE_READ_URL=
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# Redis (Upstash, ElastiCache, etc.)
REDIS_URL="rediss://:<password>@<upstash-host>:6379"
# Optional: read replica URL for read-only Redis-style cache reads when set
REDIS_READ_URL=
# Most managed Redis providers embed the password in the URL; leave blank unless needed
REDIS_PASSWORD=
# /me and profile cache (seconds)
REDIS_TTL_ME=900
REDIS_TTL_PROFILE=3600
REDIS_COMMAND_TIMEOUT_MS=3000

# JWT (one secret used for access and refresh tokens)
JWT_ACCESS_SECRET="<access-secret-base64>"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_SECRET=<refresh-secret-base64>

# System Admin JWT (separate from user tokens; iss claim offoo-admin)
ADMIN_JWT_SECRET="<admin-access-secret-min-32-chars>"
ADMIN_JWT_REFRESH_SECRET="<admin-refresh-secret-min-32-chars>"
ADMIN_JWT_ACCESS_EXPIRES_IN=15m
ADMIN_JWT_REFRESH_EXPIRES_IN=7d
# Seed-time only (npm run seed:super-admin)
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# WebSocket (GET /ws) — Phase 4–7
WS_MAX_INCOMING_BYTES=65536
WS_MAX_CLIENT_FRAMES_PER_SEC=80
WS_IDLE_TIMEOUT_MS=180000
WS_MAX_CONV_JOINS_PER_SOCKET=200

# k6 load testing (auth suite in k6-auth-tests/)
# BASE_URL should point to this API server; INFLUX_URL/GRAFANA_URL
# are only needed when streaming metrics to InfluxDB + Grafana.
BASE_URL=http://localhost:3000
INFLUX_URL=http://localhost:8086
GRAFANA_URL=http://localhost:3000

# Firebase Admin (same project as app google-services.json, e.g. project_id olappnew).
# Create a service account in Firebase Console → Project settings → Service accounts → Generate new private key.
# Do not commit the JSON; set project id + client_email + private_key here.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Sign-In ID tokens (iss=https://accounts.google.com): audiences from google-services.json oauth_client.
# Web client (client_type 3), required for typical Flutter google_sign_in server verification:
GOOGLE_OAUTH_WEB_CLIENT_ID=
# Android OAuth client (client_type 1); add if your tokens use this client as aud:
GOOGLE_OAUTH_ANDROID_CLIENT_ID=
# iOS OAuth client (client_type 2); add for com.example.olApp (or your bundle id):
GOOGLE_OAUTH_IOS_CLIENT_ID=

# Optional: ML, SMS, etc.
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=

# OTP (generation, verify, delivery)
# OTP is hashed in DB; plain OTP is never returned in API responses or server logs.
OTP_EXPIRES_IN_MINUTES=5
OTP_MAX_ATTEMPTS=5
# Fixed 5-digit OTP for local dev only (still hashed in DB). Do not set in production.
STATIC_OTP_DEV=22222
# When false (default), OTP is stored but not sent via providers. Use STATIC_OTP_DEV locally.
OTP_DELIVERY_ENABLED=false
# MSG91 — phone OTP: first 2 requests in the window → WhatsApp (SMS fallback on WA failure);
# 3rd+ request in the same window → SMS. Window seconds are admin-configurable
# (GET/PUT /v1/admin/otp-delivery/config, default 120s).
MSG91_AUTH_KEY=
MSG91_SMS_TEMPLATE_ID=
MSG91_WHATSAPP_TEMPLATE_ID=otp_delivery
MSG91_WHATSAPP_SENDER=918081551751
# Optional — MSG91 template JSON shows "namespace": null for otp_delivery; omit unless your template has a value
# MSG91_WHATSAPP_NAMESPACE=
MSG91_WHATSAPP_LANGUAGE_CODE=en
MSG91_SENDER_ID=
MSG91_DLT_ENTITY_ID=
# AWS SES — email OTP (credentials separate from S3 keys below)
SES_FROM_EMAIL=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# OTP delivery cost snapshot (minor units, e.g. paise for INR) stored on each otp_delivery_audits row.
OTP_COST_CURRENCY=INR
OTP_COST_EMAIL_MINOR=2
OTP_COST_WHATSAPP_MINOR=25
OTP_COST_SMS_MINOR=15

# AWS S3 (presigned URL avatar uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=ol-app-storage
REKOGNITION_COLLECTION_ID=face-staging
REKOGNITION_QUALITY_FILTER=AUTO
FACE_MATCH_THRESHOLD_PASS=90
FACE_MATCH_THRESHOLD_REJECT=70
FACE_MIN_DETECT_CONFIDENCE=98
FACE_VERIFY_TIMEOUT_MS=4000
FACE_INDEX_TIMEOUT_MS=8000
FACE_LIVENESS_REQUIRED=false
FACE_REGISTER_RATE_PER_HOUR=5
FACE_VERIFY_RATE_PER_HOUR=10
# Standalone `npm run worker:face-index` (Postgres poll; not used by API)
FACE_INDEX_POLL_MS=2000
FACE_INDEX_BATCH=5
# Face quality / moderation (registration + verification)
FACE_MIN_BRIGHTNESS=30
FACE_MIN_SHARPNESS=30
FACE_MAX_LANDMARKS_MISSING=2
FACE_LANDMARK_MIN_CONFIDENCE=85
FACE_MODERATION_NUDITY_THRESHOLD=50
FACE_MODERATION_STRICT_MODE=false
FACE_MIN_USER_AGE=16
FACE_CHECK_MINOR_AGE=true
FACE_GENDER_AUTO_UPDATE_ENABLED=false
FACE_DUPLICATE_CHECK_ENABLED=true
FACE_CONTENT_MODERATION_ENABLED=false
# Live-photo verify worker nudity + content-policy checks (default on; independent of face registration).
LIVE_PHOTO_CONTENT_MODERATION_ENABLED=true
FACE_GARISH_SATURATION_MAX=85
FACE_MONOCHROME_SATURATION_MAX=10
# Optional: CDN host (no https://) for avatars uploaded via PATCH /users/me
CLOUDFRONT_DOMAIN=
MAX_AVATAR_SIZE_BYTES=5242880

# Live photo verify (CompareFaces vs indexed face; worker:face-index)
LIVE_PHOTO_MATCH_THRESHOLD=95
LIVE_PHOTO_UPLOAD_URL_EXPIRES_SEC=900
LIVE_PHOTO_MAX_SIZE_BYTES=7340032
LIVE_PHOTO_UPLOAD_URL_RATE_PER_HOUR=30
LIVE_PHOTO_VERIFY_RATE_PER_HOUR=20
LIVE_PHOTO_WORKER_CONCURRENCY=8

# Security password (separate from login password)
SECURITY_PASSWORD_ENABLED=true
SECURITY_PASSWORD_FAILED_ATTEMPTS_LIMIT=6
SECURITY_PASSWORD_LOCKOUT_DURATION_MINUTES=60
SECURITY_PASSWORD_RESET_TOKEN_EXPIRY_SECONDS=600

# WebSocket Server (separate process)
WS_PORT=3001

# Messaging
MSG_HOT_CACHE_SIZE=40
MSG_UPLOAD_TTL_SECONDS=300

# Gifts — points credited to receiver = floor(coinCost * rate)
# Deprecated: gift host share is fixed at 60% in code (host-revenue-shares.ts).
GIFT_COIN_TO_POINT_RATE=0.6
# Comma-separated user UUIDs allowed to manage gifts / galleries (JWT must match)
ADMIN_USER_IDS=

# Public ID — rare pattern pre-generation (signup sequence stays in next_public_id_sequence)
# How far ahead of next_value to classify VIP-pattern IDs (bigint / numeric string)
PUBLIC_ID_PREGEN_HORIZON_AHEAD=1000000
PUBLIC_ID_PREGEN_BATCH_SIZE=5000
# Fallback if sequence row missing (must match signup default)
PUBLIC_ID_INITIAL_VALUE=34216589

# Store rare public ID lease length (days)
STORE_RARE_ID_DURATION_DAYS=15

# Optional rare-ID coin prices by tier rank (1=BRONZE … 4=DIAMOND); defaults apply if unset
# VIP_PRICE_TIER_1=
# VIP_PRICE_TIER_2=
# VIP_PRICE_TIER_3=
# VIP_PRICE_TIER_4=

# LiveKit backend → ol-node-rest session webhooks (must match LiveKit server config)
LIVE_WEBHOOK_SECRET=<shared-secret-min-32-chars-for-live-session-webhooks>
LIVE_SESSION_TIMEOUT_HOURS=6