  detectedLabel String   @map("detected_label") @db.VarChar(255)
  confidence    Float
  action        String   @db.VarChar(50)
  s3Key         String?  @map("s3_key") @db.VarChar(512)
  s3Bucket      String?  @map("s3_bucket") @db.VarChar(255)
  checkedAt     DateTime @default(now()) @map("checked_at")

  session VideoCallSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
