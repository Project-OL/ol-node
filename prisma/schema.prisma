// ─── System Admin (separate identity from User) ───
enum AdminRole {
  SUPER_ADMIN
  MODERATOR
  FINANCE
  CONTENT
  CUSTOMER_SUPPORT
}

enum AdminStatus {
  ACTIVE
  DISABLED
  SUSPENDED
}

model SystemAdmin {
  id                String      @id @default(uuid())
  email             String      @unique
  passwordHash      String      @map("password_hash")
  role              AdminRole   @default(MODERATOR)
  displayName       String      @map("display_name")
  // isActive is derived from status — the only writer is csaManagementService.setStatus
  // (isActive = status === 'ACTIVE'); login/verifyAccessToken keep checking isActive.
  isActive          Boolean     @default(true) @map("is_active")
  username          String?     @unique @db.VarChar(50)
  phone             String?     @db.VarChar(20)
  phoneCountryCode  String?     @map("phone_country_code") @db.VarChar(8)
  gender            String?     @db.VarChar(20)
  country           String?     @db.VarChar(100)
  status            AdminStatus @default(ACTIVE)
  failedLoginCount  Int         @default(0) @map("failed_login_count")
  lastFailedLoginAt DateTime?   @map("last_failed_login_at")
  lockedUntil       DateTime?   @map("locked_until")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  lastLoginAt       DateTime?   @map("last_login_at")

  sessions        AdminSession[]
  assignedTickets SupportTicket[]       @relation("TicketAssignee")
  ticketNotes     SupportTicketNote[]
  notifications   CsaNotification[]
  reviewedReports MessageReport[]       @relation("ReportReviewer")
  viewAssignments AdminViewAssignment[]
  ipWhitelist     AdminIpWhitelist[]
  loginFailures   AdminLoginFailure[]

  @@map("system_admins")
}

/// Append-only failed admin login events. Consecutive lockout counters on
/// system_admins still reset on success; these rows do not.
enum AdminLoginFailureReason {
  INVALID_CREDENTIALS
  ACCOUNT_LOCKED
  ADMIN_IP_FORBIDDEN
}

model AdminLoginFailure {
  id         String                   @id @default(uuid())
  adminId    String                   @map("admin_id")
  email      String                   @db.VarChar(255)
  reason     AdminLoginFailureReason
  ipAddress  String?                  @map("ip_address") @db.VarChar(45)
  userAgent  String?                  @map("user_agent") @db.VarChar(512)
  createdAt  DateTime                 @default(now()) @map("created_at")

  admin SystemAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("admin_login_failures")
}

/// Exact IPv4/IPv6 allow-list for admin login. CSAs always require a match
/// (empty list = cannot log in). SUPER_ADMIN checks when env SUPER_ADMIN_IP_WHITELIST_ENABLED=true.
model AdminIpWhitelist {
  id              String      @id @default(uuid())
  adminId         String      @map("admin_id")
  admin           SystemAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  /// Normalized exact address (IPv4 or IPv6 lowercase; IPv4-mapped forms stored as IPv4).
  ipAddress       String      @map("ip_address") @db.VarChar(45)
  createdByAdminId String?    @map("created_by_admin_id")
  createdAt       DateTime    @default(now()) @map("created_at")

  @@unique([adminId, ipAddress])
  @@index([adminId])
  @@map("admin_ip_whitelist")
}

// Named group of admin endpoints ("METHOD /admin/path") the panel renders as one view.
// SUPER_ADMIN always sees everything; other admins with >=1 assignment are restricted
// to (and granted) exactly the endpoints of their assigned views.
model AdminView {
  id               String   @id @default(uuid())
  name             String   @unique @db.VarChar(100)
  endpoints        String[] @default([])
  createdByAdminId String?  @map("created_by_admin_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  assignments AdminViewAssignment[]

  @@map("admin_views")
}

model AdminViewAssignment {
  id                String      @id @default(uuid())
  adminId           String      @map("admin_id")
  admin             SystemAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  viewId            String      @map("view_id")
  view              AdminView   @relation(fields: [viewId], references: [id], onDelete: Cascade)
  assignedByAdminId String?     @map("assigned_by_admin_id")
  createdAt         DateTime    @default(now()) @map("created_at")

  @@unique([adminId, viewId])
  @@index([viewId])
  @@map("admin_view_assignments")
}

model AdminSession {
  id        String      @id @default(uuid())
  adminId   String      @map("admin_id")
  admin     SystemAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String      @map("token_hash")
  ipAddress String?     @map("ip_address")
  userAgent String?     @map("user_agent")
  expiresAt DateTime    @map("expires_at")
  revokedAt DateTime?   @map("revoked_at")
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([adminId])
  @@index([tokenHash])
  @@map("admin_sessions")
}

model Banner {
  id               String   @id @default(uuid()) @db.Uuid
  title            String   @db.VarChar(200)
  imageUrl         String   @map("image_url") @db.Text
  position         String   @db.VarChar(100)
  startAt          DateTime @map("start_at")
  endAt            DateTime @map("end_at")
  enabled          Boolean  @default(true)
  createdByAdminId String?  @map("created_by_admin_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([enabled, startAt, endAt])
  @@index([position])
  @@index([createdAt(sort: Desc)])
  @@map("banners")
}

enum CustomGiftRequestStatus {
  PENDING
  COMPLETED
  FAILED
}

model CustomGiftConfig {
  id               Int      @id @default(1)
  /// Legacy / default price (= 1-month package). Kept for older clients.
  coinCost         BigInt   @default(100000) @map("coin_cost")
  /// Coins for a 1-month custom gift request.
  coinCost1Month   BigInt   @default(100000) @map("coin_cost_1_month")
  /// Coins for a 3-month custom gift request.
  coinCost3Months  BigInt   @default(200000) @map("coin_cost_3_months")
  enabled          Boolean  @default(true)
  description      String?  @db.Text
  updatedAt        DateTime @updatedAt @map("updated_at")
  updatedByAdminId String?  @map("updated_by_admin_id") @db.Uuid

  @@map("custom_gift_config")
}

model CustomGiftRequest {
  id                  String                  @id @default(uuid()) @db.Uuid
  userId              String                  @map("user_id") @db.Uuid
  whatsappNumber      String                  @map("whatsapp_number") @db.VarChar(32)
  note                String?                 @db.Text
  /// Requested gift validity in days (optional; CS uses when creating the catalog gift).
  validityDays        Int?                    @map("validity_days")
  coinCost            BigInt                  @map("coin_cost")
  ledgerEntryId       String                  @map("ledger_entry_id") @db.Uuid
  status              CustomGiftRequestStatus @default(PENDING)
  giftId              String?                 @map("gift_id") @db.Uuid
  adminNote           String?                 @map("admin_note") @db.Text
  failureReason       String?                 @map("failure_reason") @db.Text
  refunded            Boolean                 @default(false)
  refundLedgerEntryId String?                 @map("refund_ledger_entry_id") @db.Uuid
  resolvedByAdminId   String?                 @map("resolved_by_admin_id") @db.Uuid
  resolvedAt          DateTime?               @map("resolved_at")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntry       CoinLedgerEntry  @relation("CustomGiftRequestDebit", fields: [ledgerEntryId], references: [id], onDelete: Restrict)
  refundLedgerEntry CoinLedgerEntry? @relation("CustomGiftRequestRefund", fields: [refundLedgerEntryId], references: [id], onDelete: Restrict)
  gift              Gift?            @relation(fields: [giftId], references: [id], onDelete: SetNull)

  @@unique([ledgerEntryId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("custom_gift_requests")
}

// ─── FCM push delivery log (admin + product pushes) ───
enum PushDeliveryStatus {
  SENT
  FAILED
  SKIPPED
}

enum PushDeliverySource {
  ADMIN_SINGLE
  ADMIN_BROADCAST
  TRANSACTION
  NEW_MESSAGE
  SUPPORT_TICKET
}

model PushDeliveryLog {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  /// SystemAdmin id when source is admin — not FK (admins live in system_admins).
  adminUserId String?             @map("admin_user_id") @db.Uuid
  source      PushDeliverySource
  status      PushDeliveryStatus
  campaignId  String?             @map("campaign_id") @db.VarChar(128)
  title       String              @db.VarChar(200)
  body        String              @db.VarChar(1000)
  data        Json?
  errorCode   String?             @map("error_code") @db.VarChar(100)
  createdAt   DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([source, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([campaignId])
  @@map("push_delivery_logs")
}

// ─── LEDGER / VIP AUDIT FLAGS (overnight irregularity scan) ───

enum LedgerAuditCategory {
  VIP
  COIN
  POINT
  TRADING_COIN
}

enum LedgerAuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum LedgerAuditStatus {
  OPEN
  ACKNOWLEDGED
  DISMISSED
}

model LedgerAuditFlag {
  id                 String               @id @default(uuid()) @db.Uuid
  userId             String               @map("user_id") @db.Uuid
  category           LedgerAuditCategory
  code               String               @db.VarChar(64)
  severity           LedgerAuditSeverity
  status             LedgerAuditStatus    @default(OPEN)
  fingerprint        String               @unique @db.VarChar(255)
  summary            String               @db.Text
  evidence           Json
  ledgerEntryId      String?              @map("ledger_entry_id") @db.Uuid
  pointLedgerEntryId String?              @map("point_ledger_entry_id") @db.Uuid
  vipPurchaseId      String?              @map("vip_purchase_id") @db.Uuid
  windowStart        DateTime             @map("window_start")
  windowEnd          DateTime             @map("window_end")
  resolvedAt         DateTime?            @map("resolved_at")
  /// SystemAdmin id — not FK (admins live in system_admins).
  resolvedByAdminId  String?              @map("resolved_by_admin_id") @db.Uuid
  resolutionNote     String?              @map("resolution_note") @db.Text
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)])
  @@index([category, createdAt(sort: Desc)])
  @@index([code, createdAt(sort: Desc)])
  @@index([severity, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("ledger_audit_flags")
}
