model PostTag {
  id           String   @id @default(cuid())
  postId       String   @map("post_id")
  taggedUserId String   @map("tagged_user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  post       Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  taggedUser User @relation("TaggedIn", fields: [taggedUserId], references: [id], onDelete: Cascade)

  @@unique([postId, taggedUserId])
  @@index([postId])
  @@index([taggedUserId])
  @@map("post_tags")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("PostLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("post_likes")
}

// ─── MESSAGING ───
enum ConversationType {
  DIRECT
  GROUP
  SYSTEM
  NOTIFICATION
  TRANSACTIONAL
}

enum MessageType {
  TEXT
  TEXT_COINS
  IMAGE
  VIDEO
  AUDIO
  FILE
  SYSTEM
  TRANSACTIONAL
  NOTIFICATION
  GIFT
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  FILE
}

// Async sidecar processing for message media (waveform extraction, transcoding, etc.).
enum MediaProcessingStatus {
  NONE
  PENDING
  ENQUEUED
  READY
  FAILED
}

// Future transcription pipeline; persisted for client UX.
enum MediaTranscriptionStatus {
  NONE
  PENDING
  READY
  FAILED
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE_CONTENT
  FAKE_ACCOUNT
  VIOLENCE
  OTHER
  GIFT_FRAUD
  MULTIPLE_ACCOUNT
  TOP_UP_FRAUD
  LIVE_BROADCAST_VIOLATION
  CHILD_SAFETY_VIOLATION
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

model Conversation {
  id            String               @id @default(cuid())
  type          ConversationType
  lastMessageAt DateTime?            @map("last_message_at")
  // Monotonic per-conversation message sequence
  lastSeq       BigInt               @default(0) @map("last_seq")
  /// Sorted `userA:userB` UUID pair for DIRECT uniqueness; null for GROUP/platform.
  directPairKey String?              @unique @map("direct_pair_key")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  members       ConversationMember[]
  messages      Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationMember {
  id                String       @id @default(cuid())
  conversationId    String       @map("conversation_id")
  userId            String       @map("user_id") @db.Uuid
  joinedAt          DateTime     @default(now()) @map("joined_at")
  lastReadAt        DateTime?    @map("last_read_at")
  lastReadMessageId String?      @map("last_read_message_id")
  isMuted           Boolean      @default(false) @map("is_muted")
  mutedUntil        DateTime?    @map("muted_until")
  isDeleted         Boolean      @default(false) @map("is_deleted")
  deletedAt         DateTime?    @map("deleted_at")
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@map("conversation_members")
}

model Message {
  id              String            @id @default(cuid())
  conversationId  String            @map("conversation_id")
  senderId        String            @map("sender_id") @db.Uuid
  type            MessageType
  content         String?           @db.Text
  metadata        Json?             @map("metadata")
  replyToId       String?           @map("reply_to_id")
  isDeleted       Boolean           @default(false) @map("is_deleted")
  deletedAt       DateTime?         @map("deleted_at")
  editedAt        DateTime?         @map("edited_at")
  // Idempotency key (UUID) when set; unique per conversation
  clientMessageId String?           @map("client_message_id")
  isAutoReply     Boolean           @default(false) @map("is_auto_reply")
  // Per-conversation monotonic order
  seq             BigInt            @map("seq")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  conversation    Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User              @relation("SentMessages", fields: [senderId], references: [id])
  replyTo         Message?          @relation("MessageReplies", fields: [replyToId], references: [id])
  replies         Message[]         @relation("MessageReplies")
  mediaItems      MessageMedia[]
  reactions       MessageReaction[]

  @@unique([conversationId, clientMessageId])
  @@unique([conversationId, seq])
  @@index([conversationId, seq])
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

// Transactional outbox: at-least-once WS fan-out after commit
model MessageOutbox {
  id             BigInt    @id @default(autoincrement())
  conversationId String    @map("conversation_id")
  payload        Json
  createdAt      DateTime  @default(now()) @map("created_at")
  publishedAt    DateTime? @map("published_at")

  @@index([publishedAt, id])
  @@map("message_outbox")
}

model MessageMedia {
  id                  String                   @id @default(cuid())
  messageId           String                   @map("message_id")
  mediaType           MediaType                @map("media_type")
  s3Key               String                   @map("s3_key") @db.VarChar(500)
  s3Bucket            String                   @map("s3_bucket") @db.VarChar(255)
  fileName            String?                  @map("file_name") @db.VarChar(255)
  mimeType            String?                  @map("mime_type") @db.VarChar(100)
  sizeBytes           Int?                     @map("size_bytes")
  durationSec         Int?                     @map("duration_sec")
  width               Int?
  height              Int?
  order               Int                      @default(0)
  // Compact waveform: `{ "v": 1, "e": "<base64 u8 peaks>" }` or legacy normalized floats (bounded).
  waveformJson        Json?                    @map("waveform_json")
  codec               String?                  @map("codec") @db.VarChar(32)
  bitrate             Int?                     @map("bitrate")
  sampleRate          Int?                     @map("sample_rate")
  channels            Int?                     @map("channels")
  processingStatus    MediaProcessingStatus    @default(NONE) @map("processing_status")
  transcriptionStatus MediaTranscriptionStatus @default(NONE) @map("transcription_status")
  checksumSha256      String?                  @map("checksum_sha256") @db.VarChar(64)
  createdAt           DateTime                 @default(now()) @map("created_at")
  message             Message                  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([processingStatus, createdAt])
  @@index([createdAt])
  @@map("message_media")
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id") @db.Uuid
  emoji     String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

model BlockList {
  id        String   @id @default(cuid())
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  blocker   User     @relation("BlockedBy", fields: [blockerId], references: [id])
  blocked   User     @relation("BlockedUsers", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("block_lists")
}

model MessageReport {
  id                String        @id @default(cuid())
  reporterId        String        @map("reporter_id") @db.Uuid
  reportedUserId    String        @map("reported_user_id") @db.Uuid
  conversationId    String?       @map("conversation_id")
  messageId         String?       @map("message_id")
  reason            ReportReason
  additionalInfo    String?       @map("additional_info") @db.Text
  evidenceS3Keys    String[]      @map("evidence_s3_keys")
  status            ReportStatus  @default(PENDING)
  context           ReportContext @default(CHAT)
  liveSessionId     String?       @map("live_session_id")
  hostUserId        String?       @map("host_user_id") @db.Uuid
  reviewedByAdminId String?       @map("reviewed_by_admin_id")
  reviewedAt        DateTime?     @map("reviewed_at")
  resolutionNote    String?       @map("resolution_note") @db.Text
  escalatedTicketId BigInt?       @map("escalated_ticket_id") @db.BigInt
  createdAt         DateTime      @default(now()) @map("created_at")
  reporter          User          @relation("Reporter", fields: [reporterId], references: [id])
  reportedUser      User          @relation("Reported", fields: [reportedUserId], references: [id])
  hostUser          User?         @relation("ReportedLiveHost", fields: [hostUserId], references: [id], onDelete: SetNull)
  reviewedByAdmin   SystemAdmin?  @relation("ReportReviewer", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  restrictions      UserRestriction[]

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([createdAt])
  @@index([status, createdAt(sort: Desc)])
  @@index([context, status])
  @@map("message_reports")
}

/// Timed, per-feature moderation flags (live chat mute, live audio mute, messaging ban, live-start ban).
/// Each type is independent — admins apply only the restrictions needed for a given report.
enum UserRestrictionType {
  LIVE_CHAT_MUTE
  LIVE_AUDIO_MUTE
  MESSAGING_DISABLE
  LIVE_STREAM_START_BAN
}

model UserRestriction {
  id               String              @id @default(uuid()) @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  type             UserRestrictionType
  restrictedUntil  DateTime            @map("restricted_until")
  reason           String?             @db.Text
  /// Optional link to the message/live report that triggered this restriction.
  reportId         String?             @map("report_id")
  createdByAdminId String              @map("created_by_admin_id")
  clearedAt        DateTime?           @map("cleared_at")
  clearedByAdminId String?             @map("cleared_by_admin_id")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  user    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  report  MessageReport?           @relation(fields: [reportId], references: [id], onDelete: SetNull)
  /// Empty = MESSAGING_DISABLE applies to every recipient (legacy global send ban).
  targets UserRestrictionTarget[]

  @@index([userId, type, clearedAt])
  @@index([userId, restrictedUntil])
  @@index([reportId])
  @@map("user_restrictions")
}

/// Recipients a MESSAGING_DISABLE restriction applies to. No rows = all users.
model UserRestrictionTarget {
  id            String @id @default(uuid()) @db.Uuid
  restrictionId String @map("restriction_id") @db.Uuid
  targetUserId  String @map("target_user_id") @db.Uuid

  restriction UserRestriction @relation(fields: [restrictionId], references: [id], onDelete: Cascade)
  targetUser  User            @relation("RestrictionTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([restrictionId, targetUserId])
  @@index([targetUserId])
  @@map("user_restriction_targets")
}

model BroadcastReminder {
  id           String    @id @default(cuid())
  userId       String    @map("user_id") @db.Uuid
  creatorId    String    @map("creator_id") @db.Uuid
  remindAt     DateTime? @map("remind_at")
  isSent       Boolean   @default(false) @map("is_sent")
  notifyOnLive Boolean   @default(false) @map("notify_on_live")
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation("ReminderOwner", fields: [userId], references: [id])
  creator      User      @relation("ReminderCreator", fields: [creatorId], references: [id])

  @@unique([userId, creatorId])
  @@index([remindAt, isSent])
  @@index([creatorId, notifyOnLive])
  @@map("broadcast_reminders")
}

/// Live-stream chat messages (shared with livestream backend). PG table name is "LiveMessage".
model LiveMessage {
  id               String   @id @default(uuid())
  streamId         String
  senderId         String
  message          String
  createdAt        DateTime @default(now())
  replyToMessageId String?  @map("reply_to_message_id")
  replyToUserId    String?  @map("reply_to_user_id")
  replyToUsername  String?  @map("reply_to_username")
  replyToText      String?  @map("reply_to_text")
}

// ── Wallet: coins & points ───────────────────────────────────────────────────

enum WalletCurrencyType {
  COIN
  POINT
  TRADING_COIN
  /// Third-party game currency; users buy in with COIN 1:1 and redeem back 1:1.
  DIAMOND
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum CoinTxType {
  TOPUP
  TRADING_TOPUP
  GIFT_SEND
  GIFT_REFUND
  TRANSFER_OUT
  TRANSFER_IN
  TRADING_TRANSFER_OUT
  TRADING_TRANSFER_IN
  TRADING_EXCHANGE_FROM_POINTS
  TRADING_TRANSFER_REVERSAL
  VIP_PURCHASE
  VIP_REWARD
  DAILY_LOGIN
  WEEKLY_TOPUP
  PLATFORM_REWARD
  EXPIRE
  ADJUSTMENT
  VIDEO_CALL
  USERNAME_CHANGE
  CREATOR_SUBSCRIPTION
  GUARDIAN_PURCHASE
  STORE_ITEM_PURCHASE
  GLOBAL_MESSAGE
  VIP_MEMBERSHIP_PURCHASE
  POINT_EXCHANGE_TO_COINS
  CUSTOM_GIFT_REQUEST
  CUSTOM_GIFT_REFUND
  // Diamond wallet — Coin↔Diamond conversion (1:1, both pegged 10,000 = $1 USD).
  DIAMOND_PURCHASE_OUT // COIN wallet debit
  DIAMOND_PURCHASE_IN // DIAMOND wallet credit
  DIAMOND_REDEEM_OUT // DIAMOND wallet debit
  DIAMOND_REDEEM_IN // COIN wallet credit
  // Diamond wallet — third-party game settlement (user leg + GAME_HOUSE counterparty leg).
  GAME_WAGER_OUT // user DIAMOND debit (bet)
  GAME_WAGER_IN // house DIAMOND credit (bet)
  GAME_RESULT_OUT // house DIAMOND debit (win payout)
  GAME_RESULT_IN // user DIAMOND credit (win payout)
  GAME_REFUND_OUT // house DIAMOND debit (bet refund)
  GAME_REFUND_IN // user DIAMOND credit (bet refund)
  GAME_ADJUSTMENT // admin manual correction
}

enum PointTxType {
  LIVESTREAM_GIFT
  SUBSCRIPTION
  GUARDIAN_PURCHASE
  COMMISSION
  TRANSFER_IN
  TRANSFER_OUT
  PLATFORM_REWARD
  WITHDRAWAL
  WITHDRAWAL_REFUND
  ADJUSTMENT
  VIDEO_CALL
  GIFT_RECEIVE
  AGENCY_FORCE_EXIT_PENALTY
  AGENT_COMMISSION
  AGENT_POINT_TRANSFER
  PAYROLL_PROCESSING_REWARD
  // Withdrawal & payroll v2 — escrow model
  WITHDRAWAL_ESCROW // host: soft mark of in-flight escrow (does NOT reduce ledger sum)
  WITHDRAWAL_ESCROW_SETTLED // host: real debit at payroll completion (reduces ledger sum)
  PAYROLL_HOST_PAYOUT // agent: credit of hostPayoutPoints at payroll completion
  LIVESTREAM_STREAK_REWARD // first-7-days livestream daily reward (2 parts/day); excluded from commission + livestream XP
  /// Company-agency inventory when platform takes over a failed BANK payroll (host payout units).
  PAYROLL_TAKEOVER_INVENTORY
}

