  tags  PostTag[]
  likes PostLike[]

  @@index([userId, createdAt])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "posts_user_id_created_at_id_idx")
  @@index([createdAt])
  @@map("posts")
