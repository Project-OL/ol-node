  @@index([classification, createdAt(sort: Desc)])
  @@map("treasury_flow_classifications")
}

/// Daily materialized unit float so period-start balances do not re-scan every wallet.
model LedgerFloatSnapshot {
  id         String   @id @default(uuid()) @db.Uuid
  snapshotAt DateTime @unique @map("snapshot_at")

  customerCoins        BigInt @default(0) @map("customer_coins")
  customerTradingCoins BigInt @default(0) @map("customer_trading_coins")
  customerHostPoints   BigInt @default(0) @map("customer_host_points")
  customerAgencyPoints BigInt @default(0) @map("customer_agency_points")
  customerTotal        BigInt @default(0) @map("customer_total")

  houseCoins        BigInt @default(0) @map("house_coins")
  houseTradingCoins BigInt @default(0) @map("house_trading_coins")
  housePoints       BigInt @default(0) @map("house_points")
  houseTotal        BigInt @default(0) @map("house_total")

  ledgerNet      BigInt @default(0) @map("ledger_net")
  identityDelta  BigInt @default(0) @map("identity_delta")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([snapshotAt(sort: Desc)])
  @@map("ledger_float_snapshots")
}

// ── Diamonds & third-party game integration ─────────────────────────────────
// Diamonds ride the existing Wallet/CoinLedgerEntry machinery (WalletCurrencyType.DIAMOND)
// — no bespoke ledger table. These models are the explicit pairing/audit rows on top,
// mirroring CoinTradingTransfer's pattern of FK'ing both ledger legs from one header row.

enum DiamondConversionDirection {
  BUY
  REDEEM
}

/// Pairs the COIN leg + DIAMOND leg of a single Coin↔Diamond conversion (1:1).
model DiamondConversion {
  id                   String                     @id @default(uuid()) @db.Uuid
  userId               String                     @map("user_id") @db.Uuid
  direction            DiamondConversionDirection
  coinAmount           BigInt                     @map("coin_amount")
  diamondAmount        BigInt                     @map("diamond_amount")
  coinLedgerEntryId    String                     @map("coin_ledger_entry_id") @db.Uuid
  diamondLedgerEntryId String                     @map("diamond_ledger_entry_id") @db.Uuid
  idempotencyKey       String                     @unique @map("idempotency_key") @db.VarChar(200)
  createdAt            DateTime                   @default(now()) @map("created_at")

  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  coinLedgerEntry    CoinLedgerEntry @relation("DiamondConversionCoinLeg", fields: [coinLedgerEntryId], references: [id], onDelete: Restrict)
  diamondLedgerEntry CoinLedgerEntry @relation("DiamondConversionDiamondLeg", fields: [diamondLedgerEntryId], references: [id], onDelete: Restrict)

  @@unique([coinLedgerEntryId])
  @@unique([diamondLedgerEntryId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("diamond_conversions")
}

/// One row per (provider, channel) credential set the app is configured to launch games
/// against. `code` is a free-text provider key (e.g. "BAISHUN"), not an enum, so a new
/// provider can be onboarded via a DB row + a new adapter class — no schema migration.
/// The real API secret (BAISHUN's appKey) is never stored here — env-only, see GameProvider docs.
model GameProvider {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @db.VarChar(30)
  channel    String   @db.VarChar(100)
  appId      String   @map("app_id") @db.VarChar(100)
  appChannel String   @map("app_channel") @db.VarChar(100)
  baseUrl    String   @map("base_url") @db.VarChar(255)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  catalogEntries   GameCatalogEntry[]
  sessions         GameSession[]
  roundLedgerLinks GameRoundLedgerLink[]

  @@unique([code, channel])
  @@index([isActive])
  @@map("game_providers")
}

/// Cached mirror of a provider's game list (e.g. BAISHUN `/v1/api/gamelist`), Redis-fronted.
model GameCatalogEntry {
  id          String   @id @default(uuid()) @db.Uuid
  providerId  String   @map("provider_id") @db.Uuid
  gameId      Int      @map("game_id")
  name        String   @db.VarChar(150)
  previewUrl  String?  @map("preview_url") @db.VarChar(500)
  downloadUrl String?  @map("download_url") @db.VarChar(500)
  gameVersion String?  @map("game_version") @db.VarChar(30)
  gameMode    Int[]    @map("game_mode")
  orientation Int?     @map("orientation")
  safeHeight  Int?     @map("safe_height")
  venueLevel  Int[]    @map("venue_level")
  isActive    Boolean  @default(true) @map("is_active")
  syncedAt    DateTime @default(now()) @map("synced_at")

  provider GameProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, gameId])
  @@index([providerId, isActive])
  @@map("game_catalog_entries")
}

enum GameSessionStatus {
  ISSUED
  ACTIVE
  EXPIRED
}

/// Backs a provider's session lifecycle (BAISHUN: temp `code` → `get_sstoken` → `ss_token`).
model GameSession {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  providerId       String            @map("provider_id") @db.Uuid
  gameId           Int               @map("game_id")
  code             String            @unique @db.VarChar(64)
  codeUsedAt       DateTime?         @map("code_used_at")
  ssToken          String?           @unique @map("ss_token") @db.VarChar(255)
  ssTokenExpiresAt DateTime?         @map("ss_token_expires_at")
  roomId           String?           @map("room_id") @db.VarChar(100)
  status           GameSessionStatus @default(ISSUED)
  createdAt        DateTime          @default(now()) @map("created_at")
  lastActivityAt   DateTime          @updatedAt @map("last_activity_at")

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider GameProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, ssTokenExpiresAt])
  @@map("game_sessions")
}

/// Pairs the user DIAMOND leg + GAME_HOUSE DIAMOND leg of one BAISHUN `change_balance`
/// settlement. Unique on (providerId, orderId) is the idempotency anchor for settlement
/// retries — BAISHUN reuses the same order_id on retry and requires no double-settlement.
model GameRoundLedgerLink {
  id                 String   @id @default(uuid()) @db.Uuid
  providerId         String   @map("provider_id") @db.Uuid
  orderId            String   @map("order_id") @db.VarChar(255)
  gameId             Int      @map("game_id")
  roomId             String?  @map("room_id") @db.VarChar(100)
  diffMsg            String   @map("diff_msg") @db.VarChar(20)
  userId             String   @map("user_id") @db.Uuid
  currencyDiff       BigInt   @map("currency_diff")
  userLedgerEntryId  String   @map("user_ledger_entry_id") @db.Uuid
  houseLedgerEntryId String   @map("house_ledger_entry_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")

  provider         GameProvider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userLedgerEntry  CoinLedgerEntry @relation("GameRoundUserLeg", fields: [userLedgerEntryId], references: [id], onDelete: Restrict)
  houseLedgerEntry CoinLedgerEntry @relation("GameRoundHouseLeg", fields: [houseLedgerEntryId], references: [id], onDelete: Restrict)

  @@unique([providerId, orderId])
  @@unique([userLedgerEntryId])
  @@unique([houseLedgerEntryId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("game_round_ledger_links")
}

model UserPaymentMethod {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  methodType             String    @map("method_type") @db.VarChar(10)
  epayEmail              String?   @map("epay_email") @db.VarChar(255)
  bankName               String?   @map("bank_name") @db.VarChar(255)
  bankAccountHolder      String?   @map("bank_account_holder") @db.VarChar(255)
  accountHolderFirstName String?   @map("account_holder_first_name") @db.VarChar(100)
  accountHolderLastName  String?   @map("account_holder_last_name") @db.VarChar(100)
  branch                 String?   @db.VarChar(150)
  bankAccountNumber      String?   @map("bank_account_number") @db.VarChar(50)
  bankIfscCode           String?   @map("bank_ifsc_code") @db.VarChar(20)
  upiNumber              String?   @map("upi_number") @db.VarChar(50)
  registeredPhone        String?   @map("registered_phone") @db.VarChar(30)
  registeredEmail        String?   @map("registered_email") @db.VarChar(255)
  lastUsedAt             DateTime? @map("last_used_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawals Withdrawal[]

  @@unique([userId, methodType])
  @@index([userId])
  @@map("user_payment_methods")
}

model WithdrawalPayrollAssignment {
  id               String    @id @default(uuid()) @db.Uuid
  withdrawalId     String    @map("withdrawal_id") @db.Uuid
  agencyUserId     String    @map("agency_user_id") @db.Uuid
  assignedAt       DateTime  @default(now()) @map("assigned_at")
  expiresAt        DateTime  @map("expires_at")
  status           String    @default("PENDING") @map("status") @db.VarChar(20)
  proofS3Key       String?   @map("proof_s3_key") @db.VarChar(500)
  proofS3Bucket    String?   @map("proof_s3_bucket") @db.VarChar(255)
  completedAt      DateTime? @map("completed_at")
  rejectedAt       DateTime? @map("rejected_at")
  rejectionReason  String?   @map("rejection_reason") @db.Text
  assignmentNumber Int       @map("assignment_number")
  waitingExpiresAt DateTime? @map("waiting_expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  withdrawal Withdrawal @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)
  agencyUser User       @relation("AgencyPayrollAssignments", fields: [agencyUserId], references: [id], onDelete: Cascade)

  @@index([withdrawalId, assignmentNumber])
  @@index([agencyUserId, status, assignedAt(sort: Desc)])
  @@index([status, expiresAt])
  @@index([agencyUserId, status, updatedAt(sort: Desc)])
  @@map("withdrawal_payroll_assignments")
}

model PayrollConfig {
  id                    Int      @id @default(1)
  platformFeeRateBp     Int      @default(500) @map("platform_fee_rate_bp") // legacy display; runtime uses payroll_fee_tiers
  agentRewardRateBp     Int      @default(6000) @map("agent_reward_rate_bp") // legacy display; runtime uses payroll_fee_tiers
  serviceFeeUsd         Decimal  @default(1.00) @map("service_fee_usd") @db.Decimal(8, 2)
  minWithdrawalUsd      Decimal  @default(10.00) @map("min_withdrawal_usd") @db.Decimal(12, 2)
  maxWithdrawalUsd      Decimal  @default(10000000.00) @map("max_withdrawal_usd") @db.Decimal(18, 2)
  slaHours              Int      @default(2) @map("sla_hours")
  waitingHours          Int      @default(2) @map("waiting_hours")
  maxAssignmentAttempts Int      @default(5) @map("max_assignment_attempts")
  inrPerUsd             Decimal  @default(94.00) @map("inr_per_usd") @db.Decimal(8, 2)
  nprPerUsd             Decimal  @default(150.00) @map("npr_per_usd") @db.Decimal(10, 4)
  updatedAt             DateTime @updatedAt @map("updated_at")
  updatedByUserId       String?  @map("updated_by_user_id") @db.Uuid

  @@map("payroll_config")
}

/// Withdrawal amount bands → platform fee % and agent reward share of that fee.
/// Soft-replace via admin `PUT /admin/agency/payroll/config` `feeTiers`.
/// Bounds are gross points; `maxPoints` is exclusive (`null` = open-ended).
model PayrollFeeTier {
  id                 String   @id @default(uuid()) @db.Uuid
  minPoints          BigInt   @map("min_points")
  maxPoints          BigInt?  @map("max_points")
  platformFeeRateBp  Int      @map("platform_fee_rate_bp")
  agentRewardRateBp  Int      @map("agent_reward_rate_bp")
  sortOrder          Int      @map("sort_order")
  isActive           Boolean  @default(true) @map("is_active")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("payroll_fee_tiers")
}

/// Admin-managed local FX: country → currency + units per 1 USD.
/// Used for withdrawal and agency point-transfer display amounts.
model PayrollCountryFxRate {
  id           String   @id @default(uuid()) @db.Uuid
  country      String   @db.VarChar(80)
  countryCode  String?  @map("country_code") @db.VarChar(8)
  currencyCode String   @map("currency_code") @db.VarChar(8)
  ratePerUsd   Decimal  @map("rate_per_usd") @db.Decimal(12, 4)
  sortOrder    Int      @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([country])
  @@index([isActive, sortOrder])
  @@map("payroll_country_fx_rates")
}

model WithdrawalPayoutRailConfig {
  id              Int      @id @default(1)
  epayFeeRateBp   Int      @default(600) @map("epay_fee_rate_bp")
  epayArrivalTime String   @default("Within 24 hours") @map("epay_arrival_time") @db.VarChar(200)
  epayEnabled     Boolean  @default(true) @map("epay_enabled")
  bankFeeRateBp   Int      @default(600) @map("bank_fee_rate_bp")
  bankArrivalTime String   @default("3-5 business days") @map("bank_arrival_time") @db.VarChar(200)
  bankEnabled     Boolean  @default(true) @map("bank_enabled")
  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid

  @@map("withdrawal_payout_rail_config")
}

/// Singleton: shared host message edit/delete action window.
model MessagingConfig {
  id              Int      @id @default(1)
  /// Duration from message createdAt during which sender may edit or soft-delete.
  actionWindowMs  Int      @default(3600000) @map("action_window_ms")
  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid

  @@map("messaging_config")
}

/// Singleton: PENDING_REVIEW contest window before auto-close (resolve/reject tickets).
model SupportConfig {
  id              Int      @id @default(1)
  /// Duration from `resolvedAt` during which the user may reply to contest.
  reviewWindowMs  Int      @default(86400000) @map("review_window_ms")
  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid

  @@map("support_config")
}

/// Singleton: Face Liveness gates (legacy register block + Amplify STS credentials required).
/// Admin `GET|PUT /admin/system-settings/face-liveness`. First create seeds from env.
model FaceLivenessConfig {
  id                   Int      @id @default(1)
  /// When true, legacy `POST /face-verification/register` is rejected.
  livenessRequired     Boolean  @default(false) @map("liveness_required")
  /// When true, `POST /face-registration/session` fails if STS temp creds cannot be minted.
  credentialsRequired  Boolean  @default(false) @map("credentials_required")
  updatedAt            DateTime @updatedAt @map("updated_at")
  updatedByUserId      String?  @map("updated_by_user_id") @db.Uuid

  @@map("face_liveness_config")
}

/// Singleton: admin/CSA login lockout after consecutive wrong passwords.
/// Admin `GET|PUT /admin/system-settings/admin-auth`. Default 5 failures → 24h lock.
model AdminAuthConfig {
  id                    Int      @id @default(1)
  /// Consecutive wrong passwords that set `system_admins.locked_until`.
  failedLoginThreshold  Int      @default(5) @map("failed_login_threshold")
  /// Lock duration once the threshold is reached (minutes). Default 1440 = 24 hours.
  lockoutMinutes        Int      @default(1440) @map("lockout_minutes")
  updatedAt             DateTime @updatedAt @map("updated_at")
  updatedByUserId       String?  @map("updated_by_user_id") @db.Uuid

  @@map("admin_auth_config")
}

/// Append-only GPS samples; `users.last_*` holds the current fix.
model UserLocationSample {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  latitude  Decimal  @db.Decimal(9, 6)
  longitude Decimal  @db.Decimal(9, 6)
  accuracyM Float?   @map("accuracy_m")
  /// Client source tag, e.g. app_gps, coarse, background.
  source    String   @default("app_gps") @db.VarChar(40)
  recordedAt DateTime @default(now()) @map("recorded_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt(sort: Desc)])
  @@index([recordedAt(sort: Desc)])
  @@map("user_location_samples")
}

/// Singleton: phone OTP channel routing window (WhatsApp for first N-1, SMS from Nth within interval).
model OtpDeliveryConfig {
  id                    Int      @id @default(1)
  /// Rolling window (seconds) for per-phone OTP request counting used to pick WhatsApp vs SMS.
  smsTriggerIntervalSec Int      @default(120) @map("sms_trigger_interval_sec")
  updatedAt             DateTime @updatedAt @map("updated_at")
  updatedByUserId       String?  @map("updated_by_user_id") @db.Uuid

  @@map("otp_delivery_config")
}

/// Durable OTP generation/delivery audit for admin portal (purpose, channel, charged cost).
model OtpDeliveryAudit {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String?  @map("user_id") @db.Uuid
  /// Flow that requested the OTP (signup, login, set_security_password, modify_*, …).
  purpose           String   @db.VarChar(50)
  /// Delivery means: email | whatsapp | sms | none (skipped / not sent).
  means             String   @db.VarChar(20)
  /// Provider id when sent: ses_email | msg91_whatsapp | msg91_sms.
  provider          String?  @db.VarChar(40)
  /// success | failed | skipped
  status            String   @db.VarChar(20)
  targetType        String   @map("target_type") @db.VarChar(20)
  targetMasked      String   @map("target_masked") @db.VarChar(255)
  /// ISO-3166-1 alpha-2 from phone, else users.country when known.
  country           String?  @db.VarChar(100)
  /// Cost in minor currency units (e.g. paise when currency=INR); 0 when not charged.
  chargeMinor       Int      @default(0) @map("charge_minor")
  chargeCurrency    String   @default("INR") @map("charge_currency") @db.VarChar(3)
  providerMessageId String?  @map("provider_message_id") @db.VarChar(255)
  fallbackFrom      String?  @map("fallback_from") @db.VarChar(40)
  routeReason       String?  @map("route_reason") @db.VarChar(60)
  error             String?  @db.VarChar(500)
  createdAt         DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([purpose, createdAt(sort: Desc)])
  @@index([means, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([country, createdAt(sort: Desc)])
  @@map("otp_delivery_audits")
}

/// Per-country OTP cost override (WhatsApp conversation pricing and SMS termination
/// rates both vary by destination country). No row for a (means, country) pair falls
/// back to the global OTP_COST_WHATSAPP_MINOR / OTP_COST_SMS_MINOR env default.
model OtpCostRate {
  id              String   @id @default(uuid()) @db.Uuid
  /// whatsapp | sms — email cost stays flat (OTP_COST_EMAIL_MINOR), not country-priced.
  means           String   @db.VarChar(20)
  /// ISO-3166-1 alpha-2, upper-case (e.g. IN, US, AE).
  country         String   @db.VarChar(2)
  rateMinor       Int      @map("rate_minor")
  currency        String   @default("INR") @db.VarChar(3)
  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid

  @@unique([means, country])
  @@map("otp_cost_rates")
}

model WalletIdempotencyLog {
