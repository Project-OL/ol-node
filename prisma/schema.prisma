  livePhotoId          String   @map("live_photo_id") @db.Uuid
  similarityScore      Float?   @map("similarity_score")
  matched              Boolean  @default(false)
  rekognitionRequestId String?  @map("rekognition_request_id") @db.VarChar(128)
  failureReason        String?  @map("failure_reason") @db.Text
  metadata             Json?    @db.JsonB
  processingLatencyMs  Int?     @map("processing_latency_ms")
  rekognitionLatencyMs Int?     @map("rekognition_latency_ms")
  createdAt            DateTime @default(now()) @map("created_at")

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  livePhoto UserLivePhoto @relation(fields: [livePhotoId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([livePhotoId, createdAt(sort: Desc)])
  @@map("live_photo_verification_attempts")
}

/// Active liveness-gated first registration (AWS Face Liveness → reference image → `PENDING_INDEX` → worker-face-index).
enum FaceRegistrationSessionStatus {
  PENDING
  UPLOADED
  PROCESSING
  LIVENESS_PASSED
  LIVENESS_FAILED
  VALIDATION_FAILED
  INDEX_PENDING
  INDEXED
  REJECTED
  EXPIRED
}

model FaceRegistrationSession {
  id                     String                        @id @default(uuid()) @db.Uuid
  userId                 String                        @map("user_id") @db.Uuid
  status                 FaceRegistrationSessionStatus @default(PENDING)
  /// Amazon Rekognition Face Liveness `SessionId` from CreateFaceLivenessSession.
  awsSessionId           String?                       @map("aws_session_id") @db.VarChar(128)
  /// UX + audit: ordered challenge hints (randomized server-side); AWS SDK performs its own challenge.
  challengeSequence      Json                          @map("challenge_sequence")
  challengeNonce         String                        @map("challenge_nonce") @db.VarChar(64)
  supplementalVideoS3Key String?                       @map("supplemental_video_s3_key") @db.Text
  uploadNonce            String?                       @map("upload_nonce") @db.VarChar(64)
  riskScore              Float                         @default(0) @map("risk_score")
  deviceMetadata         Json?                         @map("device_metadata")
  ipAddress              String?                       @map("ip_address") @db.VarChar(64)
  failureReason          String?                       @map("failure_reason") @db.Text
  /// Rekognition liveness reference image saved on a failed/rejected attempt (LIVENESS_FAILED/VALIDATION_FAILED), for admin review. Null when no image was captured (e.g. session never reached liveness, or expired before completion).
  failureImageS3Key      String?                       @map("failure_image_s3_key") @db.Text
  livenessConfidence     Float?                        @map("liveness_confidence")
  rekognitionRawStatus   String?                       @map("rekognition_raw_status") @db.VarChar(32)
  idempotencyKey         String?                       @map("idempotency_key") @db.Uuid
  awsRequestId           String?                       @map("aws_request_id") @db.VarChar(128)
  expiresAt              DateTime                      @map("expires_at")
  verifiedAt             DateTime?                     @map("verified_at")
  indexedAt              DateTime?                     @map("indexed_at")
  createdAt              DateTime                      @default(now()) @map("created_at")
  updatedAt              DateTime                      @updatedAt @map("updated_at")

  user      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs FaceRegistrationAuditLog[]

  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("face_registration_sessions")
}

model FaceRegistrationAuditLog {
  id                     String   @id @default(uuid()) @db.Uuid
  sessionId              String   @map("session_id") @db.Uuid
  userId                 String   @map("user_id") @db.Uuid
  action                 String   @db.VarChar(64)
  details                Json?
  ipAddress              String?  @map("ip_address") @db.VarChar(64)
  userAgent              String?  @map("user_agent") @db.Text
  latencyMs              Int?     @map("latency_ms")
  qualityCheckFailures   String[] @default([]) @map("quality_check_failures")
  detectedGender         String?  @map("detected_gender") @db.VarChar(50)
  genderAutoUpdated      Boolean? @map("gender_auto_updated")
  duplicateMatchUserId   String?  @map("duplicate_match_user_id") @db.Uuid
  contentPolicyViolation Boolean? @map("content_policy_violation")
  createdAt              DateTime @default(now()) @map("created_at")

  session FaceRegistrationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("face_registration_audit_logs")
}

model FaceProfileRevocation {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  faceProfileId     String?  @map("face_profile_id") @db.Uuid
  /// App user who initiated revocation (self-service); null for admin actions.
  revokedByUserId   String?  @map("revoked_by_user_id") @db.Uuid
