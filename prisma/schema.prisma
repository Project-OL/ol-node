model UserLivePhoto {
  id                  String                     @id @default(uuid()) @db.Uuid
  userId              String                     @unique @map("user_id") @db.Uuid
  s3Key               String                     @map("s3_key") @db.Text
  s3Bucket            String                     @map("s3_bucket") @db.VarChar(255)
  imageUrl            String?                    @map("image_url") @db.Text
  verificationState   LivePhotoVerificationState @map("verification_state")
  similarityScore     Float?                     @map("similarity_score")
  verifiedAt          DateTime?                  @map("verified_at")
  failedReason        String?                    @map("failed_reason") @db.Text
  faceProfileId       String?                    @map("face_profile_id") @db.Uuid
  /// Next replacement object; verified `s3Key`/`imageUrl` stay until this key passes verify.
  pendingS3Key        String?                    @map("pending_s3_key") @db.Text
  pendingS3Bucket     String?                    @map("pending_s3_bucket") @db.VarChar(255)
  /// Last failed replace attempt while still VERIFIED (cleared on new upload-url / success).
  replaceFailedReason String?                    @map("replace_failed_reason") @db.Text
  /// Incremented on each verify enqueue; worker ignores stale generations (latest upload wins).
  verifyGeneration    Int                        @default(0) @map("verify_generation")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")

  user        User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  faceProfile UserFaceProfile?               @relation(fields: [faceProfileId], references: [id], onDelete: SetNull)
  attempts    LivePhotoVerificationAttempt[]

  @@index([verificationState])
  @@map("user_live_photos")
}

