// ── Gifts, gallery, fan ranking ───────────────────────────────────────────────

model GiftCategory {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(255)
  slug         String   @unique @db.VarChar(64)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  gifts Gift[]

  @@index([isActive])
  @@index([displayOrder])
  @@map("gift_categories")
}

model Gift {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(255)
  code            String   @unique @db.VarChar(64)
  coinCost        Int      @map("coin_cost")
  displayImageUrl String   @map("display_image_url") @db.Text
  effectUrl       String?  @map("effect_url") @db.Text
  displayOrder    Int      @default(0) @map("display_order")
  vipOnly         Boolean  @default(false) @map("vip_only")
  isLucky         Boolean  @default(false) @map("is_lucky")
  isActive        Boolean  @default(true) @map("is_active")
  categoryId      String?  @map("category_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  category            GiftCategory?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags                GiftTag[]
  gallerySectionItems GiftGallerySectionItem[]
  transactions        GiftTransaction[]
  galleryProgressRows GiftGalleryProgress[]
  customGiftRequests  CustomGiftRequest[]

  @@index([isActive])
  @@index([isLucky])
  @@index([categoryId])
  @@index([displayOrder])
  @@map("gifts")
}

model GiftTag {
  id     String @id @default(uuid()) @db.Uuid
  giftId String @map("gift_id") @db.Uuid
  tag    String @db.VarChar(64)

  gift Gift @relation(fields: [giftId], references: [id], onDelete: Cascade)

  @@unique([giftId, tag])
  @@index([tag])
  @@map("gift_tags")
}

model GiftGallery {
  id        String   @id @default(uuid()) @db.Uuid
  year      Int
  month     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sections GiftGallerySection[]
  progress GiftGalleryProgress[]

  @@unique([year, month])
  @@map("gift_galleries")
}

model GiftGallerySection {
  id        String    @id @default(uuid()) @db.Uuid
  galleryId String    @map("gallery_id") @db.Uuid
  title     String    @db.VarChar(255)
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  enabledAt DateTime? @map("enabled_at")

  gallery GiftGallery              @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  gifts   GiftGallerySectionItem[]

  @@index([galleryId])
  @@map("gift_gallery_sections")
}

model GiftGallerySectionItem {
  id        String @id @default(uuid()) @db.Uuid
  sectionId String @map("section_id") @db.Uuid
  giftId    String @map("gift_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  section      GiftGallerySection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  gift         Gift                  @relation(fields: [giftId], references: [id], onDelete: Cascade)
  progressRows GiftGalleryProgress[]

  @@unique([sectionId, giftId])
  @@index([giftId])
  @@map("gift_gallery_section_items")
}

model GiftGalleryProgress {
  id                       String   @id @default(uuid()) @db.Uuid
  galleryId                String   @map("gallery_id") @db.Uuid
  hostUserId               String   @map("host_user_id") @db.Uuid
  giftId                   String   @map("gift_id") @db.Uuid
  giftGallerySectionItemId String   @map("gift_gallery_section_item_id") @db.Uuid
  firstGifterId            String   @map("first_gifter_id") @db.Uuid
  receivedAt               DateTime @default(now()) @map("received_at")

  gallery     GiftGallery            @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  host        User                   @relation("HostGalleryProgress", fields: [hostUserId], references: [id], onDelete: Cascade)
  firstGifter User                   @relation("GifterGalleryProgress", fields: [firstGifterId], references: [id], onDelete: Restrict)
  gift        Gift                   @relation(fields: [giftId], references: [id], onDelete: Restrict)
  sectionItem GiftGallerySectionItem @relation(fields: [giftGallerySectionItemId], references: [id], onDelete: Cascade)

  @@unique([hostUserId, giftGallerySectionItemId])
  @@index([hostUserId, galleryId])
  @@index([galleryId])
  @@map("gift_gallery_progress")
}

model GiftTransaction {
  id             String   @id @default(uuid()) @db.Uuid
  senderUserId   String   @map("sender_user_id") @db.Uuid
  receiverUserId String   @map("receiver_user_id") @db.Uuid
  giftId         String   @map("gift_id") @db.Uuid
  coinCost       Int      @map("coin_cost")
  pointsAwarded  Int      @map("points_awarded")
  /// Units of the catalog gift in this send (combo quantity). Default 1.
  quantity       Int      @default(1)
  context        String   @default("direct") @db.VarChar(32)
  createdAt      DateTime @default(now()) @map("created_at")

  sender   User @relation("GiftsSent", fields: [senderUserId], references: [id], onDelete: Restrict)
  receiver User @relation("GiftsReceived", fields: [receiverUserId], references: [id], onDelete: Restrict)
  gift     Gift @relation(fields: [giftId], references: [id], onDelete: Restrict)

  @@index([senderUserId])
  @@index([receiverUserId])
  @@index([createdAt])
  @@map("gift_transactions")
}

model FanSpend {
  id             String   @id @default(uuid()) @db.Uuid
  senderUserId   String   @map("sender_user_id") @db.Uuid
  receiverUserId String   @map("receiver_user_id") @db.Uuid
  periodType     String   @map("period_type") @db.VarChar(16)
  periodKey      String   @map("period_key") @db.VarChar(16)
  coinsSpent     BigInt   @default(0) @map("coins_spent")
  updatedAt      DateTime @updatedAt @map("updated_at")

  sender   User @relation("FanSpendSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  receiver User @relation("FanSpendReceiver", fields: [receiverUserId], references: [id], onDelete: Cascade)

  @@unique([senderUserId, receiverUserId, periodType, periodKey])
  @@index([receiverUserId, periodType, periodKey])
  @@map("fan_spend")
}

// ─── AGENCY (Phase 1 — commission/payroll in later phases) ───

enum AgencyApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum AgencyLeaveApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  LATE_APPROVED
  AUTO_APPROVED
  CANCELLED
}

enum AgencyHostHistoryReason {
  LEAVE_APPROVED
  LEAVE_AUTO_APPROVED
  LEAVE_LATE_APPROVED
  REMOVED_INACTIVE
  REMOVED_SUSPENDED
  CS_FORCE_EXIT
  ADMIN_FORCE_EXIT
  AGENT_DELETED
  HOST_DELETED
  AGENCY_BANNED
}

model Agency {
  userId                     String    @id @map("user_id") @db.Uuid
  defaultPublicId            BigInt    @unique @map("default_public_id")
  displayName                String    @map("display_name") @db.VarChar(255)
  /// Admin-granted right to participate in payroll. When false, agent cannot enable accept-toggle.
  payrollPrivilegeGranted    Boolean   @default(false) @map("payroll_privilege_granted")
  payrollEnabled             Boolean   @default(false) @map("payroll_enabled")
  /// First time agent enabled accept-toggle (kept on disable; used for assignment seniority).
  payrollEnabledAt           DateTime? @map("payroll_enabled_at")
  pausedAt                   DateTime? @map("paused_at")
  pausedUntil                DateTime? @map("paused_until")
  totalHostsCount            Int       @default(0) @map("total_hosts_count")
  lifetimeHostEarningsPoints BigInt    @default(0) @map("lifetime_host_earnings_points")
  currentLevel               String    @default("D") @map("current_level") @db.VarChar(8)
  currentWindowTotalPoints   BigInt    @default(0) @map("current_window_total_points")
  lastLevelRecomputedAt      DateTime? @map("last_level_recomputed_at")
  /// Admin-assigned base tier; recomputes cannot drop below this until `tierLockUntil`.
  tierLockLevel              String?   @map("tier_lock_level") @db.VarChar(8)
  /// End of admin tier lock (assignment time + rolling-window duration snapshotted at set).
  tierLockUntil              DateTime? @map("tier_lock_until")
  /// Signed bonus: minWindowPoints(lockLevel) − actual window total at assignment.
  tierLockBonusPoints        BigInt?   @map("tier_lock_bonus_points")
  lastPayrollAssignedAt      DateTime? @map("last_payroll_assigned_at")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hosts              AgencyHost[]
  applications       AgencyHostApplication[]
  leaveApplications  AgencyLeaveApplication[]
  dailyEarnings      AgencyDailyEarning[]
  coinsellerSettings AgencyCoinseller?

  @@index([payrollEnabled, pausedAt])
  @@index([payrollEnabled, pausedAt, lastPayrollAssignedAt])
  @@index([payrollEnabled, payrollEnabledAt])
  @@index([payrollPrivilegeGranted, payrollEnabled, pausedAt])
  @@index([currentLevel, currentWindowTotalPoints(sort: Desc)])
  @@index([totalHostsCount(sort: Desc)])
  @@map("agencies")
}

enum AgencyTransferChannel {
  BANK
  EPAY
}

model AgencyCoinseller {
  id                 String                @id @default(uuid()) @db.Uuid
  agencyUserId       String                @unique @map("agency_user_id") @db.Uuid
  transferChannel    AgencyTransferChannel @default(EPAY) @map("transfer_channel")
  whatsappNumber     String?               @map("whatsapp_number") @db.VarChar(30)
  priceImageS3Key    String?               @map("price_image_s3_key") @db.VarChar(512)
  priceImageS3Bucket String?               @map("price_image_s3_bucket") @db.VarChar(128)
  autoReply          String?               @map("auto_reply") @db.VarChar(100)
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  agency Agency @relation(fields: [agencyUserId], references: [userId], onDelete: Cascade)

  @@map("agency_coinseller_settings")
}

model AgencyHost {
  agencyUserId String   @map("agency_user_id") @db.Uuid
  hostUserId   String   @id @map("host_user_id") @db.Uuid
  joinedAt     DateTime @default(now()) @map("joined_at")

  agency Agency @relation(fields: [agencyUserId], references: [userId], onDelete: Cascade)
  host   User   @relation(fields: [hostUserId], references: [id], onDelete: Cascade)

  @@index([agencyUserId, joinedAt(sort: Desc)])
  @@map("agency_hosts")
}

model AgencyHostApplication {
  id               String                  @id @default(uuid()) @db.Uuid
  agencyUserId     String                  @map("agency_user_id") @db.Uuid
  hostUserId       String                  @map("host_user_id") @db.Uuid
  status           AgencyApplicationStatus
  message          String?                 @db.Text
  createdAt        DateTime                @default(now()) @map("created_at")
  resolvedAt       DateTime?               @map("resolved_at")
  resolvedByUserId String?                 @map("resolved_by") @db.Uuid
  updatedAt        DateTime                @updatedAt @map("updated_at")

  agency     Agency @relation(fields: [agencyUserId], references: [userId], onDelete: Cascade)
  host       User   @relation("AgencyAppHost", fields: [hostUserId], references: [id], onDelete: Cascade)
  resolvedBy User?  @relation("AgencyAppResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([hostUserId, status, createdAt(sort: Desc)])
  @@index([agencyUserId, status, createdAt(sort: Desc)])
  @@map("agency_host_applications")
}

model AgencyLeaveApplication {
  id               String                       @id @default(uuid()) @db.Uuid
  agencyUserId     String                       @map("agency_user_id") @db.Uuid
  hostUserId       String                       @map("host_user_id") @db.Uuid
  status           AgencyLeaveApplicationStatus
  reason           String?                      @db.Text
  createdAt        DateTime                     @default(now()) @map("created_at")
  resolvedAt       DateTime?                    @map("resolved_at")
  resolvedByUserId String?                      @map("resolved_by") @db.Uuid
  autoApproveAt    DateTime                     @map("auto_approve_at")
  lateApproveUntil DateTime?                    @map("late_approve_until")
  updatedAt        DateTime                     @updatedAt @map("updated_at")

  agency     Agency @relation(fields: [agencyUserId], references: [userId], onDelete: Cascade)
  host       User   @relation("AgencyLeaveHost", fields: [hostUserId], references: [id], onDelete: Cascade)
  resolvedBy User?  @relation("AgencyLeaveResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([hostUserId, status, createdAt(sort: Desc)])
  @@index([agencyUserId, status, createdAt(sort: Desc)])
  @@index([status, autoApproveAt])
  @@map("agency_leave_applications")
}

model AgencyHostHistory {
  id           String                  @id @default(uuid()) @db.Uuid
  agencyUserId String                  @map("agency_user_id") @db.Uuid
  hostUserId   String                  @map("host_user_id") @db.Uuid
  joinedAt     DateTime                @map("joined_at")
  exitedAt     DateTime                @default(now()) @map("exited_at")
  reason       AgencyHostHistoryReason
  exitMetadata Json?                   @map("exit_metadata")

  @@index([hostUserId, exitedAt(sort: Desc)])
  @@index([agencyUserId, exitedAt(sort: Desc)])
  @@map("agency_host_history")
}

/// Seeded ladder: D / C / B / A / S / SS+ (rates in basis points).
model AgencyCommissionLevel {
  level           String   @id @db.VarChar(8)
  minWindowPoints BigInt   @map("min_window_points")
  liveRateBp      Int      @map("live_rate_bp")
  matchChatRateBp Int      @map("match_chat_rate_bp")
  sortOrder       Int      @map("sort_order")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("agency_commission_levels")
}

/// Singleton: agency tier/level rolling window (days + hours + minutes).
model AgencyCommissionConfig {
  id               Int      @id @default(1)
  windowDays       Int      @default(30) @map("window_days")
  windowHours      Int      @default(0) @map("window_hours")
  windowMinutes    Int      @default(0) @map("window_minutes")
  updatedAt        DateTime @updatedAt @map("updated_at")
  updatedByAdminId String?  @map("updated_by_admin_id")

  @@map("agency_commission_config")
}

/// Singleton: wait after host exit or rejected join before applying again.
/// Admin `GET|PUT /admin/system-settings/agency-host`. Default 24 hours.
model AgencyHostConfig {
  id                   Int      @id @default(1)
  rejoinCooldownHours  Int      @default(24) @map("rejoin_cooldown_hours")
  updatedAt            DateTime @updatedAt @map("updated_at")
  updatedByAdminId     String?  @map("updated_by_admin_id")

  @@map("agency_host_config")
}

/// Singleton: first-N-days livestream daily reward (2 parts/day at 1h and 2h streamed).
/// Admin `GET|PUT /admin/system-settings/livestream-reward`. Default 7 days, 2,500 points/hour.
model LivestreamRewardConfig {
  id             Int      @id @default(1)
  /// Membership days 1..N eligible for the reward window.
  windowDays     Int      @default(7) @map("window_days")
  /// Points credited per hour milestone (part 1 at 1h, part 2 at 2h streamed today).
  pointsPerHour  Int      @default(2500) @map("points_per_hour")
  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedByAdminId String? @map("updated_by_admin_id")

  @@map("livestream_reward_config")
}

model AgencyDailyEarning {
  agencyUserId         String    @map("agency_user_id") @db.Uuid
  hostUserId           String    @map("host_user_id") @db.Uuid
  day                  DateTime  @db.Date
  hostEarningsPoints   BigInt    @default(0) @map("host_earnings_points")
  hostCommissionPoints BigInt    @default(0) @map("host_commission_points")
  hostWasActive        Boolean   @default(true) @map("host_was_active")
  lastCreditAt         DateTime? @map("last_credit_at")
  liveDurationSeconds  BigInt    @default(0) @map("live_duration_seconds")

  agency Agency @relation(fields: [agencyUserId], references: [userId], onDelete: Cascade)
  host   User   @relation("AgencyDailyHost", fields: [hostUserId], references: [id], onDelete: Cascade)

  @@id([agencyUserId, hostUserId, day])
  @@index([agencyUserId, day(sort: Desc)])
  @@index([hostUserId, day(sort: Desc)])
  @@map("agency_daily_earnings")
}

/// Platform leaderboards: Host / Gift / Rich / Agency daily rollups (week/month = SUM over days).
enum RankingBoard {
  HOST
  GIFT
  RICH
  AGENCY
}

model RankingDailyScore {
  id        String       @id @default(uuid()) @db.Uuid
  board     RankingBoard
  entityId  String       @map("entity_id") @db.Uuid
  day       DateTime     @db.Date
  score     BigInt       @default(0)
  /// Denormalized `users.country` (Title Case) for filter index; nullable = unknown.
  country   String?      @db.VarChar(100)
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@unique([board, entityId, day])
  @@index([board, day, score(sort: Desc)])
  @@index([board, day, country, score(sort: Desc)])
  @@map("ranking_daily_scores")
}

/// Marks a host point ledger entry as processed for agency commission (same tx as applyCommission).
model AgencyCommissionProcessed {
  hostLedgerEntryId String   @id @map("host_ledger_entry_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("agency_commission_processed")
}

model HostLiveSession {
  id              String    @id @default(uuid()) @db.Uuid
  hostUserId      String    @map("host_user_id") @db.Uuid
  agencyUserId    String    @map("agency_user_id") @db.Uuid
  roomId          String    @map("room_id")
  startedAt       DateTime  @default(now()) @map("started_at")
  endedAt         DateTime? @map("ended_at")
  durationSeconds BigInt?   @map("duration_seconds")
  status          String    @default("ACTIVE")
  createdAt       DateTime  @default(now()) @map("created_at")

  host User @relation(fields: [hostUserId], references: [id], onDelete: Cascade)

  @@index([hostUserId, status])
  @@index([agencyUserId, startedAt])
  @@map("host_live_sessions")
}

model AgentPointTransfer {
  id                     String   @id @default(uuid()) @db.Uuid
  senderAgentUserId      String   @map("sender_agent_user_id") @db.Uuid
  recipientAgentUserId   String   @map("recipient_agent_user_id") @db.Uuid
  points                 BigInt
  senderLedgerEntryId    String   @map("sender_ledger_entry_id") @db.Uuid
  recipientLedgerEntryId String   @map("recipient_ledger_entry_id") @db.Uuid
  idempotencyKey         String   @unique @map("idempotency_key") @db.VarChar(200)
  createdAt              DateTime @default(now()) @map("created_at")

  sender    User @relation("AgentTransferSender", fields: [senderAgentUserId], references: [id], onDelete: Cascade)
  recipient User @relation("AgentTransferRecipient", fields: [recipientAgentUserId], references: [id], onDelete: Cascade)

  @@index([senderAgentUserId, createdAt(sort: Desc)])
  @@index([recipientAgentUserId, createdAt(sort: Desc)])
  @@map("agent_point_transfers")
}

model SupportTicket {
  id                    BigInt                   @id @default(autoincrement()) @db.BigInt
  publicId              String                   @unique @default(cuid()) @map("public_id")
  userId                String                   @map("user_id") @db.Uuid
  type                  SupportTicketType
  subType               String                   @map("sub_type") @db.VarChar(100)
  description           String                   @db.Text
  imageUrl              String?                  @map("image_url") @db.Text
  status                SupportTicketStatus      @default(AWAITING_REPLY)
  userLastReadMessageId BigInt?                  @map("user_last_read_message_id") @db.BigInt
  csLastReadMessageId   BigInt?                  @map("cs_last_read_message_id") @db.BigInt
  rating                Int?
  ratedAt               DateTime?                @map("rated_at")
  closedAt              DateTime?                @map("closed_at")
  closedByUserId        String?                  @map("closed_by_user_id") @db.Uuid
  assignedAdminId       String?                  @map("assigned_admin_id")
  assignedAt            DateTime?                @map("assigned_at")
  priority              SupportTicketPriority    @default(NORMAL)
  resolution            SupportTicketResolution?
  resolvedAt            DateTime?                @map("resolved_at")
  firstResponseAt       DateTime?                @map("first_response_at")
  // Transaction reference for payment-conflict tickets (WITHDRAWAL | POINT_TRANSFER | COIN_TRANSFER | LEDGER_ENTRY)
  refType               String?                  @map("ref_type") @db.VarChar(40)
  refId                 String?                  @map("ref_id") @db.VarChar(120)
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  user             User                @relation("SupportTicketsAsUser", fields: [userId], references: [id], onDelete: Cascade)
  closedBy         User?               @relation("SupportTicketsClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  assignedAdmin    SystemAdmin?        @relation("TicketAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages         SupportMessage[]
  notes            SupportTicketNote[]
  csaNotifications CsaNotification[]

  @@index([userId, status, updatedAt])
  @@index([status, updatedAt])
  @@index([assignedAdminId, status, updatedAt])
  @@index([refType, refId])
  @@map("support_tickets")
}

model SupportTicketNote {
