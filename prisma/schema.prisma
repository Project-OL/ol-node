  faceProfile   UserFaceProfile? @relation(fields: [faceProfileId], references: [id], onDelete: SetNull)
  revokedByUser User?            @relation("FaceProfileRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([revokedAt(sort: Desc)])
  @@map("face_profile_revocations")
}

